{
  "name": "hearthwild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A worker-driven pixel world with agentic villagers and deterministic creature ecology.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "harness": "tsx scripts/asset-harness.ts",
    "art:integrate": "tsx scripts/art-integrate.ts",
    "assets:build": "tsx scripts/assets-build.ts",
    "world:build": "tsx scripts/world-build.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests scripts .github README.md *.json *.ts index.html gallery.html",
    "format:check": "prettier --check src tests scripts .github README.md *.json *.ts index.html gallery.html",
    "test:ollama": "tsx scripts/ollama-smoke.ts",
    "test:villagers": "tsx scripts/verify-villagers.ts",
    "test:browser": "playwright test --project=journeys",
    "benchmark": "tsx scripts/benchmark.ts",
    "soak": "tsx scripts/soak.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:assets": "tsx scripts/assets-check.ts",
    "check:assets:hd": "tsx scripts/assets-check.ts --require-hd",
    "check": "npm run typecheck && npm run check:architecture && npm run check:assets && npm test && vite build",
    "benchmark:render": "tsx scripts/render-benchmark.ts",
    "beta:notes": "tsx scripts/beta-notes.ts",
    "test:beta": "playwright test --project=beta"
  },
  "dependencies": {
    "pixi.js": "^8.14.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
