{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subjectKind": {
      "type": "string",
      "enum": ["appearance", "portrait-set", "layer-set", "recipe", "effect", "furniture", "scene"]
    },
    "subjectId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "type": "string", "enum": ["approved", "rejected"] },
    "approvedBy": { "type": "string", "minLength": 1, "maxLength": 160 },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "required": [
    "id",
    "subjectKind",
    "subjectId",
    "sourceDigest",
    "decision",
    "approvedBy",
    "approvedAt"
  ],
  "additionalProperties": false
}
