{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        { "type": "number", "const": 1 },
        { "type": "number", "const": 2 }
      ]
    },
    "contentVersion": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "url": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" },
          "imageUrl": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" },
          "width": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2048 },
          "height": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2048 },
          "variants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resolution": {
                  "anyOf": [
                    { "type": "number", "const": 1 },
                    { "type": "number", "const": 0.5 }
                  ]
                },
                "url": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" },
                "imageUrl": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" },
                "width": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2048 },
                "height": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2048 }
              },
              "required": ["resolution", "url", "imageUrl", "width", "height"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "url", "imageUrl", "width", "height", "variants"],
        "additionalProperties": false
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "pageId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "textureKey": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rect": {
            "type": "object",
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "w": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              "h": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          },
          "sourceSize": {
            "type": "object",
            "properties": {
              "w": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              "h": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["w", "h"],
            "additionalProperties": false
          },
          "trim": {
            "type": "object",
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "w": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              "h": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          },
          "anchor": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "anchorPx": {
            "type": "object",
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "rigId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sockets": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1, "maxLength": 160 },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          },
          "held": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1, "maxLength": 160 },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "bucket": { "type": "integer", "minimum": 0, "maximum": 7 },
                "behind": { "type": "boolean" }
              },
              "required": ["bucket", "behind"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "pageId", "textureKey", "rect", "sourceSize", "trim", "anchor"],
        "additionalProperties": false
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "appearanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "walk",
              "run",
              "attack",
              "guard",
              "hit",
              "dash",
              "eat",
              "drink",
              "bathe",
              "work",
              "social",
              "sleep",
              "downed",
              "recovery"
            ]
          },
          "facing": { "type": "string", "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"] },
          "frameIds": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
          "playback": { "type": "string", "enum": ["loop", "once", "distance", "combat"] },
          "stride": { "type": "number", "exclusiveMinimum": 0 },
          "moveId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "phases": {
            "type": "object",
            "properties": {
              "windup": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "active": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "recovery": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": ["windup", "active", "recovery"],
            "additionalProperties": false
          }
        },
        "required": ["id", "appearanceId", "state", "facing", "frameIds", "fps", "playback"],
        "additionalProperties": false
      }
    },
    "appearances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": {
            "type": "string",
            "enum": ["species", "npc", "origin", "item", "environment", "fallback", "layer"]
          },
          "contentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "quality": { "type": "string", "enum": ["prototype", "hd"] },
          "clipIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "frameId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "fallbackId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "recipeId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "provenanceId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["id", "kind", "contentId", "quality", "clipIds"],
        "additionalProperties": false
      }
    },
    "portraits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["species", "npc", "origin"] },
          "contentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "hud96": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" },
          "hud128": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" }
        },
        "required": ["kind", "contentId", "hud96", "hud128"],
        "additionalProperties": false
      }
    },
    "rigs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canvas": {
            "type": "object",
            "properties": {
              "w": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              "h": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["w", "h"],
            "additionalProperties": false
          },
          "anchorPx": {
            "type": "object",
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "socketIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "registrations": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "canvas": {
                  "type": "object",
                  "properties": {
                    "w": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
                    "h": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
                  },
                  "required": ["w", "h"],
                  "additionalProperties": false
                },
                "anchorPx": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                  },
                  "required": ["x", "y"],
                  "additionalProperties": false
                }
              },
              "required": ["canvas", "anchorPx"],
              "additionalProperties": false
            }
          }
        },
        "required": ["canvas", "anchorPx", "id", "socketIds"],
        "additionalProperties": false
      }
    },
    "buildProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rigId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "required": ["id", "rigId", "label"],
        "additionalProperties": false
      }
    },
    "layerSets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rigId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "buildProfileIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "slot": {
            "type": "string",
            "enum": ["body", "hair", "face", "garment", "held", "overlay"]
          },
          "appearanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["id", "rigId", "buildProfileIds", "slot", "appearanceId"],
        "additionalProperties": false
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rigId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "buildProfileId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "layers": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layerSetId": { "type": "string", "minLength": 1, "maxLength": 160 },
                "z": { "type": "integer", "minimum": -100, "maximum": 100 },
                "required": { "type": "boolean" },
                "gearSlot": { "type": "string", "minLength": 1, "maxLength": 160 },
                "heldSlot": {
                  "anyOf": [
                    { "type": "number", "const": 0 },
                    { "type": "number", "const": 1 }
                  ]
                },
                "itemId": { "type": "string", "minLength": 1, "maxLength": 160 },
                "socketId": { "type": "string", "minLength": 1, "maxLength": 160 }
              },
              "required": ["layerSetId", "z", "required"],
              "additionalProperties": false
            }
          },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["id", "rigId", "buildProfileId", "layers"],
        "additionalProperties": false
      }
    },
    "portraitSets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "type": "string", "enum": ["species", "npc", "origin"] },
          "contentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "expressions": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "neutral",
                "warm",
                "thoughtful",
                "curious",
                "concerned",
                "amused",
                "angry",
                "sad",
                "fearful"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "hud96": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" },
                "hud128": { "type": "string", "pattern": "^\\/assets\\/[A-Za-z0-9_./@+-]+$" }
              },
              "required": ["hud96", "hud128"],
              "additionalProperties": false
            }
          },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "provenanceId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["id", "kind", "contentId", "expressions", "stage"],
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "clipId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "trigger": { "type": "string", "enum": ["attack", "hit", "heal", "weather", "ambient"] },
          "moveId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "attachment": { "type": "string", "enum": ["world", "actor", "socket"] },
          "rigId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "socketId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "lifetimeTicks": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1800 },
          "maxInstances": { "type": "integer", "exclusiveMinimum": 0, "maximum": 256 },
          "essential": { "type": "boolean" },
          "blendMode": { "type": "string", "enum": ["normal", "add"] },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "id",
          "clipId",
          "trigger",
          "attachment",
          "lifetimeTicks",
          "maxInstances",
          "essential",
          "blendMode"
        ],
        "additionalProperties": false
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "appearanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "footprintTiles": {
            "type": "object",
            "properties": {
              "w": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              "h": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["w", "h"],
            "additionalProperties": false
          },
          "service": {
            "type": "string",
            "enum": ["none", "rest", "eat", "drink", "wash", "work", "social"]
          },
          "occlusion": { "type": "string", "enum": ["none", "roof", "canopy"] },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["id", "appearanceId", "footprintTiles", "service", "occlusion"],
        "additionalProperties": false
      }
    },
    "sceneAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "appearanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "category": {
            "type": "string",
            "enum": ["ground", "shore", "cliff", "ramp", "canopy", "building", "prop", "weather"]
          },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["id", "appearanceId", "category"],
        "additionalProperties": false
      }
    },
    "sourceDigests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subjectKind": {
            "type": "string",
            "enum": [
              "appearance",
              "portrait-set",
              "layer-set",
              "recipe",
              "effect",
              "furniture",
              "scene"
            ]
          },
          "subjectId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["subjectKind", "subjectId", "digest"],
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "subjectKind": {
            "type": "string",
            "enum": [
              "appearance",
              "portrait-set",
              "layer-set",
              "recipe",
              "effect",
              "furniture",
              "scene"
            ]
          },
          "subjectId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "approvedBy": { "type": "string", "minLength": 1, "maxLength": 160 },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "notes": { "type": "string", "maxLength": 2000 }
        },
        "required": [
          "id",
          "subjectKind",
          "subjectId",
          "sourceDigest",
          "decision",
          "approvedBy",
          "approvedAt"
        ],
        "additionalProperties": false
      }
    },
    "reviewAppearances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": {
            "type": "string",
            "enum": ["species", "npc", "origin", "item", "environment", "fallback", "layer"]
          },
          "contentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "quality": { "type": "string", "enum": ["prototype", "hd"] },
          "clipIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "frameId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "fallbackId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "recipeId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "stage": { "type": "string", "enum": ["proof", "candidate", "approved"] },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "provenanceId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["id", "kind", "contentId", "quality", "clipIds"],
        "additionalProperties": false
      }
    },
    "reviewClips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "appearanceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "walk",
              "run",
              "attack",
              "guard",
              "hit",
              "dash",
              "eat",
              "drink",
              "bathe",
              "work",
              "social",
              "sleep",
              "downed",
              "recovery"
            ]
          },
          "facing": { "type": "string", "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"] },
          "frameIds": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
