                  "anyOf": [
                    { "type": "string", "maxLength": 500 },
                    { "type": "number" },
                    { "type": "boolean" }
                  ]
                }
              }
            },
            "required": ["id", "method", "inputs", "toolchain", "command"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schemaVersion", "frames", "appearances", "clips"],
      "additionalProperties": false
    }
  ]
}
