{
  "hearthwild-context": {
    "SessionStart": [{ "type": "command", "command": "node hooks/inject.mjs session", "timeout": 15 }],
    "PreInvocation": [{ "type": "command", "command": "node hooks/inject.mjs invocation", "timeout": 10 }]
  },
  "hearthwild-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node hooks/guard.mjs", "timeout": 10 }]
      }
    ]
  },
  "hearthwild-visual-review": {
    "PostToolUse": [
      {
        "matcher": "read_file",
        "hooks": [{ "type": "command", "command": "node hooks/track.mjs", "timeout": 10 }]
      }
    ]
  },
  "hearthwild-stop-check": {
    "Stop": [{ "type": "command", "command": "node hooks/stop.mjs", "timeout": 20 }]
  }
}
