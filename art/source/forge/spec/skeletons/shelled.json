    "legColumnCellFraction": 0.035,
    "kneeFraction": 0.5,
    "ankleHeight": 0.06,
    "toeForward": 0.06,
    "headRegionFraction": 0.18,
    "tailRegionFraction": 0.3,
    "tailOptional": true
  },
  "weights": {
