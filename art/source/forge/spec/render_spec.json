  "bake": {
    "engine": "CYCLES",
    "samples": 1,
    "pixelFilterWidth": 0.01,
    "passes": [
      "albedo",
      "normal",
      "depth"
    ],
    "exportSocketTracks": [
      "Socket_Head",
      "Socket_Hand.R",
      "Socket_Hand.L",
      "Socket_Back",
      "Socket_Mouth",
      "Root"
    ],
    "passesNote": "Alpha is carried in every pass's alpha channel. A materialId pass is added with the fit stage (garment parts), when one frame holds more than one material.",
    "socketsNote": "Sockets are armature bones named Socket_* (rig stage); bake projects each bone head per frame. Creatures carry Socket_Head, Socket_Back and Socket_Mouth; humans add the hands."
  },
  "qa": {
    "anchorDriftMaxPx": 0,
    "heightToleranceArtPx": 2,
    "facingSilhouetteAreaRatio": {
      "min": 0.55,
      "max": 1.8
    },
    "orphanPixelsMax": 0,
    "idleFlickerMaxChangedFraction": 0.08,
    "castDistinctness": {
      "minPaletteHistogramDistance": 0.25,
      "maxSilhouetteIoU": 0.9
    },
    "referenceFidelity": {
      "maxDominantColorDeltaEOk": 0.08
    },
    "valueContrast": {
      "minDeltaLOk": 0.12,
      "against": [
        "ground_grass",
        "ground_dirt",
        "ground_sand",
        "ground_freshwater"
      ]
    },
    "contactSheetScale": 4,
    "maxStatus": "candidate",
    "exportUniform2x2Blocks": true
  },
  "canvasNote": "Creature canvases leave room below the root: at 30 deg elevation a long body's front projects below the feet in s/n facings. These supersede the contract's proposed 96x96 Rivallie proof canvas (contract v2 asks for anatomy-specific creature canvases).",
  "clipNotes": "fps applies to loop/once/distance playback; combat clips are timed by the engineering move registry (CMB-3) and map onto exclusive-end frame phases derived from the doctrine ticks. strideTiles = ground covered per walk/run cycle at playback fps (contract.md stride); the default for humans. Creature templates set their own (skeletons/<t>.json gait.<clip>.strideUnits; 1 unit = 1 tile) and the forge records the value per asset. facingSet cardinals = n,e,s,w only. runtime = the engine's AnimationState and moveId (src/presentation/assets/coverage.ts CLIP_MATRIX).",
  "rigIds": {
    "humanoid": "ual2-humanoid",
    "quadruped": "quadruped-v1"
  }
